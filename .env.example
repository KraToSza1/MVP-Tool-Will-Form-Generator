# Supabase (Phase 2 persistence). Copy to .env and set values.
# Get these from Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: set to "true" to enable verbose [BUILD CLAUSES], [INTERPOLATE], and [CONDITION EVAL] console logs (default: off).
# VITE_DEBUG_CLAUSES=true
